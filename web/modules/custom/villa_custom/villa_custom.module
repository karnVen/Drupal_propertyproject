<?php

/**
 * @file
 * Primary module hooks for villa_custom module.
 */

use Drupal\Core\Template\Attribute;
use Drupal\file\Entity\File;

/**
 * Prepares variables for views-style-villa-custom-main-banner.html.twig template.
 */
function template_preprocess_views_style_villa_custom_main_banner(array &$variables): void {
  $view = $variables['view'];
  $options = $view->style_plugin->options;
  $i = 0;

  $variables['default_row_class'] = $options['default_row_class'];

  foreach ($variables['rows'] as $id => $row) {
    $i++;

    // CRITICAL: Change 'field_image_slider' if your machine name is different!
    $field_items = $row['#row']->_entity->get('field_image_slider'); 

    $file_id = NULL;
    foreach ($field_items as $item) {
      $file_id = $item->target_id;
    }

    if ($file_id) {
      $file = File::load($file_id);
      $uri = $file->getFileUri();
    } else {
      $uri = '';
    }

    // Rebuild the row with our custom variables
    $variables['rows'][$id] = [
      'content' => $row,
      'attributes' => new Attribute(),
    ];

    $variables['rows'][$id]['title'] = $row['#row']->_entity->getTitle();
    $variables['rows'][$id]['url'] = $uri;
    $variables['rows'][$id]['id'] = 'item item-' . $i;
  }
}