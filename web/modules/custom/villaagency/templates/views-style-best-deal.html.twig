

<div class="row">
  <div class="col-lg-12">
    <div class="tabs-content">
      <div class="row">
        
        <div class="nav-wrapper">
          <ul class="nav nav-tabs" role="tablist">
            {% for key, row in rows %}
              <li class="nav-item" role="presentation">
                <button class="nav-link {{ row.active_class }}" id="tab-{{ row.tab_index }}" data-bs-toggle="tab" data-bs-target="#content-{{ row.tab_index }}" type="button" role="tab" aria-controls="content-{{ row.tab_index }}" aria-selected="true">
                  {{ row['#row']._entity.field_type.entity.name.value }}
                </button>
              </li>
            {% endfor %}
          </ul>
        </div>
        
        <div class="tab-content" id="myTabContent">
          {% for key, row in rows %}
            <div class="tab-pane fade {{ row.show_class }}" id="content-{{ row.tab_index }}" role="tabpanel" aria-labelledby="tab-{{ row.tab_index }}">
              <div class="row">
                
                <div class="col-lg-3">
                  <div class="info-table">
                    <ul>
                      <li>Total Flat Space <span>{{ row.total_flat_space }} m2</span></li>
                      <li>Floor number <span>{{ row.floor_number }}</span></li>
                      <li>Number of rooms <span>{{ row.number_of_rooms }}</span></li>
                      <li>Parking Available <span>{{ row.parking_available }}</span></li>
                      <li>Payment Process <span>{{ row.payment_process }}</span></li>
                    </ul>
                  </div>
                </div>
                
                <div class="col-lg-6">
                  <img src="{{ row.image_path }}" alt="{{ row['#row']._entity.title.value }}">
                </div>
                
                <div class="col-lg-3">
                  <h4>Extra Info About Property</h4>
                  <p>{{ row.content|striptags }}</p>
                  <div class="icon-button">
                    <a href="#"><i class="fa fa-calendar"></i> Schedule a visit</a>
                  </div>
                </div>

              </div>
            </div>
          {% endfor %}
        </div>
        
      </div>
    </div>
  </div>
</div>